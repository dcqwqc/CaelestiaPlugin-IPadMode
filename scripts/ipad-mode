#!/usr/bin/env python3
"""Idempotent Hyprland/Weylus controller for a streamed companion display."""

from __future__ import annotations

import argparse
import fcntl
import json
import os
import re
import subprocess
import sys
import time
from pathlib import Path


APP = "Companion Display"
OUTPUT = "IPAD"


def ensure_hyprland_env() -> None:
    if os.environ.get("HYPRLAND_INSTANCE_SIGNATURE"):
        return
    runtime = Path(os.environ.get("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}"))
    root = runtime / "hypr"
    try:
        candidates = [p for p in root.iterdir() if p.is_dir()]
    except OSError:
        return
    if len(candidates) == 1:
        os.environ["XDG_RUNTIME_DIR"] = str(runtime)
        os.environ["HYPRLAND_INSTANCE_SIGNATURE"] = candidates[0].name


ensure_hyprland_env()
PLUGIN_ID = "dcqwqc/ipadmode"
CONFIG_PATH = Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config")) / "caelestia/plugins.json"
STATE_DIR = Path(os.environ.get("XDG_STATE_HOME", Path.home() / ".local/state")) / "ipad-mode"
STATE_PATH = STATE_DIR / "state.json"
LOCK_PATH = Path(os.environ.get("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}")) / "ipad-mode.lock"
SERVICE = "ipad-weylus.service"

DEFAULTS = {
    "defaultMode": "extend",
    "resolution": "1920x1080",
    "refreshRate": 60,
    "scale": 1.0,
    "position": "right",
    "stopWeylusOnDisconnect": True,
}


class IpadModeError(RuntimeError):
    pass


def run(argv: list[str], *, check: bool = True) -> subprocess.CompletedProcess[str]:
    result = subprocess.run(argv, text=True, stdout=subprocess.PIPE, stderr=subprocess.PIPE)
    if check and result.returncode:
        detail = result.stderr.strip() or result.stdout.strip() or f"exit status {result.returncode}"
        raise IpadModeError(f"{' '.join(argv)}: {detail}")
    return result


def hypr_json(*args: str):
    result = run(["hyprctl", "-j", *args])
    try:
        return json.loads(result.stdout)
    except json.JSONDecodeError as exc:
        raise IpadModeError(f"Hyprland returned invalid JSON for {' '.join(args)}") from exc


def hypr_eval(expression: str) -> None:
    result = run(["hyprctl", "eval", expression])
    if result.stdout.strip() != "ok":
        raise IpadModeError(f"Hyprland rejected an action: {result.stdout.strip()}")


def settings() -> dict:
    values = dict(DEFAULTS)
    try:
        data = json.loads(CONFIG_PATH.read_text())
        configured = data.get("settings", {}).get(PLUGIN_ID, {})
        if isinstance(configured, dict):
            values.update(configured)
    except (OSError, json.JSONDecodeError):
        pass

    if values["defaultMode"] not in {"extend", "duplicate"}:
        values["defaultMode"] = DEFAULTS["defaultMode"]
    if not re.fullmatch(r"[1-9][0-9]{2,4}x[1-9][0-9]{2,4}", str(values["resolution"])):
        values["resolution"] = DEFAULTS["resolution"]
    try:
        values["refreshRate"] = min(120, max(30, int(values["refreshRate"])))
        values["scale"] = min(3.0, max(0.5, float(values["scale"])))
    except (TypeError, ValueError):
        values["refreshRate"] = DEFAULTS["refreshRate"]
        values["scale"] = DEFAULTS["scale"]
    if values["position"] not in {"auto", "right", "left", "above", "below"}:
        values["position"] = DEFAULTS["position"]
    return values


def load_state() -> dict:
    try:
        data = json.loads(STATE_PATH.read_text())
        return data if isinstance(data, dict) else {}
    except (OSError, json.JSONDecodeError):
        return {}


def save_state(**updates) -> None:
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    data = load_state()
    data.update(updates)
    temp = STATE_PATH.with_suffix(".tmp")
    temp.write_text(json.dumps(data, indent=2) + "\n")
    temp.replace(STATE_PATH)


def monitors() -> list[dict]:
    return hypr_json("monitors", "all")


def ipad_monitor(items: list[dict] | None = None) -> dict | None:
    return next((item for item in (items if items is not None else monitors()) if item.get("name") == OUTPUT), None)


def source_monitor(items: list[dict]) -> dict:
    physical = [item for item in items if item.get("name") != OUTPUT and not item.get("disabled")]
    if not physical:
        raise IpadModeError("No physical Hyprland monitor is active")
    return next((item for item in physical if item.get("name") == "eDP-1"), None) \
        or next((item for item in physical if item.get("focused")), None) \
        or physical[0]


def monitor_position(choice: str, source: dict, resolution: str, scale: float) -> str:
    if choice == "auto":
        return "auto"

    width, height = (int(value) for value in resolution.split("x", 1))
    ipad_width = round(width / scale)
    ipad_height = round(height / scale)
    source_width = round(int(source["width"]) / float(source["scale"]))
    source_height = round(int(source["height"]) / float(source["scale"]))
    x, y = int(source["x"]), int(source["y"])
    positions = {
        "right": (x + source_width, y),
        "left": (x - ipad_width, y),
        "above": (x, y - ipad_height),
        "below": (x, y + source_height),
    }
    px, py = positions[choice]
    return f"{px}x{py}"


def remember_source_layout(source: dict) -> None:
    refresh = f"{float(source['refreshRate']):g}"
    save_state(sourceLayout={
        "name": source["name"],
        "mode": f"{source['width']}x{source['height']}@{refresh}",
        "position": f"{source['x']}x{source['y']}",
        "scale": float(source["scale"]),
    })


def restore_source_layout() -> None:
    layout = load_state().get("sourceLayout")
    if not isinstance(layout, dict) or not all(key in layout for key in ("name", "mode", "position", "scale")):
        return
    fields = [
        f"output = {json.dumps(str(layout['name']))}",
        f"mode = {json.dumps(str(layout['mode']))}",
        f"position = {json.dumps(str(layout['position']))}",
        f"scale = {float(layout['scale']):g}",
        'mirror = ""',
    ]
    hypr_eval("hl.monitor({ " + ", ".join(fields) + " })")


def workspace_selector(workspace: dict) -> int | str | None:
    workspace_id = workspace.get("id")
    workspace_name = workspace.get("name")
    if isinstance(workspace_id, int) and workspace_id > 0:
        return workspace_id
    if isinstance(workspace_name, str) and workspace_name:
        return f"name:{workspace_name}"
    return None


def remember_ipad_workspaces() -> None:
    selectors = []
    for workspace in hypr_json("workspaces"):
        if workspace.get("monitor") != OUTPUT or int(workspace.get("windows", 0)) <= 0:
            continue
        selector = workspace_selector(workspace)
        if selector is not None:
            selectors.append(selector)
    save_state(ipadWorkspaces=selectors)


def focus_workspace(selector: int | str | None) -> None:
    if selector is None:
        return
    hypr_eval(
        "hl.dispatch(hl.dsp.focus({ "
        f"workspace = {json.dumps(selector)}"
        " }))"
    )


def restore_ipad_workspaces() -> None:
    saved = load_state().get("ipadWorkspaces", [])
    if not isinstance(saved, list) or not saved or not ipad_monitor():
        return
    existing = hypr_json("workspaces")
    for selector in saved:
        if not isinstance(selector, (int, str)):
            continue
        name = selector.removeprefix("name:") if isinstance(selector, str) else None
        workspace = next((item for item in existing if item.get("id") == selector or item.get("name") == name), None)
        if not workspace or workspace.get("monitor") == OUTPUT:
            continue
        hypr_eval(
            "hl.dispatch(hl.dsp.workspace.move({ "
            f"workspace = {json.dumps(selector)}, monitor = {json.dumps(OUTPUT)}"
            " }))"
        )
    save_state(ipadWorkspaces=[])


def move_workspaces_home(items: list[dict] | None = None, *, remember: bool = True) -> None:
    current = items if items is not None else monitors()
    if not ipad_monitor(current):
        return
    if remember:
        remember_ipad_workspaces()
    destination = source_monitor(current)["name"]
    for workspace in hypr_json("workspaces"):
        if workspace.get("monitor") != OUTPUT:
            continue
        selector = workspace_selector(workspace)
        if selector is None:
            continue
        hypr_eval(
            "hl.dispatch(hl.dsp.workspace.move({ "
            f"workspace = {json.dumps(selector)}, monitor = {json.dumps(destination)}"
            " }))"
        )


def create_output() -> list[dict]:
    current = monitors()
    if ipad_monitor(current):
        return current
    run(["hyprctl", "output", "create", "headless", OUTPUT])
    for _ in range(20):
        time.sleep(0.05)
        current = monitors()
        if ipad_monitor(current):
            return current
    raise IpadModeError(f"Hyprland did not create the requested {OUTPUT} output")


def configure_output(mode: str, values: dict) -> None:
    current = monitors()
    existing = ipad_monitor(current)
    source = source_monitor(current)
    if mode == "duplicate":
        if not existing or existing.get("mirrorOf") in {None, "", "none"}:
            remember_source_layout(source)
            move_workspaces_home(current)
        position = "auto"
    else:
        restore_source_layout()
        current = monitors()
        source = source_monitor(current)
        position = monitor_position(values["position"], source, values["resolution"], values["scale"])

    scale = f"{values['scale']:g}"
    # Hyprland 0.56's Lua configuration rejects `hyprctl keyword monitor` as a
    # legacy parser. Apply the same native hl.monitor object used by Kagami's
    # configuration so runtime changes and login-time rules share one syntax.
    mode_value = f"{values['resolution']}@{values['refreshRate']}"
    fields = [
        f"output = {json.dumps(OUTPUT)}",
        f"mode = {json.dumps(mode_value)}",
        f"position = {json.dumps(position)}",
        f"scale = {scale}",
    ]
    if mode == "duplicate":
        fields.append(f"mirror = {json.dumps(source['name'])}")
    else:
        fields.append('mirror = ""')
    hypr_eval("hl.monitor({ " + ", ".join(fields) + " })")

    expected_width, expected_height = (int(value) for value in values["resolution"].split("x", 1))
    for _ in range(20):
        time.sleep(0.05)
        configured = ipad_monitor()
        if not configured:
            continue
        mirrored = configured.get("mirrorOf") not in {None, "", "none"}
        geometry_ok = mode == "duplicate" or (
            configured.get("width") == expected_width
            and configured.get("height") == expected_height
            and abs(float(configured.get("scale", 0)) - values["scale"]) < 0.01
        )
        if mirrored == (mode == "duplicate") and geometry_ok:
            if mode == "extend":
                restore_ipad_workspaces()
            return
    raise IpadModeError(f"Hyprland did not apply {mode} mode to {OUTPUT}")


def ensure_tailscale() -> None:
    result = run(["tailscale", "ip", "-4"], check=False)
    if result.returncode or not result.stdout.strip():
        raise IpadModeError("Tailscale is not connected")


def service_active() -> bool:
    return run(["systemctl", "--user", "is-active", "--quiet", SERVICE], check=False).returncode == 0


def weylus_running() -> bool:
    return service_active() or bool(
        run(["pgrep", "-u", str(os.getuid()), "-x", "weylus"], check=False).stdout.strip()
    )


def ensure_weylus() -> None:
    if service_active():
        return
    # A manually launched GUI owns the same port. Replace only Weylus itself;
    # unrelated Flatpak applications are never matched.
    pids = run(["pgrep", "-u", str(os.getuid()), "-x", "weylus"], check=False).stdout.split()
    for pid in pids:
        try:
            os.kill(int(pid), 15)
        except (ValueError, ProcessLookupError):
            pass
    for _ in range(30):
        if not run(["pgrep", "-u", str(os.getuid()), "-x", "weylus"], check=False).stdout.strip():
            break
        time.sleep(0.1)
    run(["systemctl", "--user", "start", SERVICE])
    for _ in range(30):
        if service_active():
            return
        time.sleep(0.1)
    detail = run(["journalctl", "--user", "-u", SERVICE, "-n", "8", "--no-pager"], check=False).stdout.strip()
    raise IpadModeError(f"Weylus failed to start{': ' + detail if detail else ''}")


def place_sumi() -> None:
    candidates = [
        Path.home() / "Projects/Sumi/scripts/sumi",
        Path.home() / ".local/bin/sumi",
    ]
    command = next((path for path in candidates if path.is_file() and os.access(path, os.X_OK)), None)
    running = any(client.get("class", "").lower() == "sumi" for client in hypr_json("clients"))
    if not running:
        if not command:
            raise IpadModeError("Sumi is not running and no Sumi launcher was found")
        subprocess.Popen([str(command), "app"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)

    targets: list[dict] = []
    for _ in range(80):
        targets = [client for client in hypr_json("clients") if client.get("class", "").lower() == "sumi"]
        if targets:
            break
        time.sleep(0.1)
    if not targets:
        raise IpadModeError("Sumi did not open")

    for client in targets:
        address = client.get("address")
        if address:
            hypr_eval(
                "hl.dispatch(hl.dsp.window.move({ "
                f"workspace = {json.dumps('name:ipad')}, window = {json.dumps('address:' + address)}"
                " }))"
            )
    hypr_eval(
        "hl.dispatch(hl.dsp.workspace.move({ "
        f"workspace = {json.dumps('name:ipad')}, monitor = {json.dumps(OUTPUT)}"
        " }))"
    )


def mode_from_system() -> str:
    monitor = ipad_monitor()
    if monitor:
        return "duplicate" if monitor.get("mirrorOf") not in {None, "", "none"} else "extend"
    saved = load_state().get("mode")
    return saved if saved in {"extend", "duplicate"} else settings()["defaultMode"]


def status() -> dict:
    try:
        current = monitors()
        monitor = ipad_monitor(current)
        running = weylus_running()
        saved_enabled = load_state().get("enabled")
        # Before the soft-power state existed, a running managed server meant
        # the old setup was on. Preserve that state across this upgrade.
        enabled = running if not isinstance(saved_enabled, bool) else saved_enabled
        mode = "off"
        if monitor:
            mode = "duplicate" if monitor.get("mirrorOf") not in {None, "", "none"} else "extend"
        return {
            "available": True,
            "active": monitor is not None and enabled and running,
            "mode": mode,
            "preferredMode": mode_from_system() if not monitor else mode,
            "output": monitor.get("name", "") if monitor else "",
            "weylusRunning": running,
            "tailscaleConnected": run(["tailscale", "ip", "-4"], check=False).returncode == 0,
        }
    except (IpadModeError, OSError) as exc:
        return {"available": False, "active": False, "mode": "off", "error": str(exc)}


def notify(summary: str, body: str = "", urgency: str = "normal") -> None:
    run(["notify-send", "-a", APP, "-u", urgency, summary, body], check=False)


def turn_on(mode: str | None = None) -> str:
    values = settings()
    requested = mode or mode_from_system()
    ensure_tailscale()
    create_output()
    configure_output(requested, values)
    ensure_weylus()
    save_state(mode=requested, enabled=True)
    # Backward compatibility only: older installations may still carry the
    # historical Sumi-specific flag. Fresh plugin settings do not create it.
    if values.get("autoLaunchSumi") and requested == "extend":
        place_sumi()
    return requested


def turn_off() -> None:
    # Soft power intentionally leaves the virtual output in place. Removing a
    # monitor forces Hyprland to migrate its workspaces; keeping it parked is
    # the only way an on/off toggle can leave the workspace graph untouched.
    if settings().get("stopWeylusOnDisconnect", True):
        run(["systemctl", "--user", "stop", SERVICE], check=False)
    save_state(enabled=False)


def remove_output() -> None:
    current = monitors()
    monitor = ipad_monitor(current)
    if monitor:
        active_workspace = workspace_selector(hypr_json("activeworkspace"))
        was_mirrored = monitor.get("mirrorOf") not in {None, "", "none"}
        if was_mirrored:
            restore_source_layout()
            current = monitors()
        move_workspaces_home(current, remember=not was_mirrored)
        run(["hyprctl", "output", "remove", OUTPUT])
        focus_workspace(active_workspace)
    run(["systemctl", "--user", "stop", SERVICE], check=False)
    save_state(enabled=False)


def set_mode(mode: str) -> None:
    save_state(mode=mode)
    if ipad_monitor():
        configure_output(mode, settings())


def main() -> int:
    parser = argparse.ArgumentParser(prog="ipad-mode")
    parser.add_argument("--quiet", action="store_true", help="do not send desktop notifications")
    sub = parser.add_subparsers(dest="command", required=True)
    sub.add_parser("toggle")
    on_parser = sub.add_parser("on")
    on_parser.add_argument("mode", nargs="?", choices=("extend", "duplicate"))
    sub.add_parser("off")
    sub.add_parser("remove")
    mode_parser = sub.add_parser("mode")
    mode_parser.add_argument("mode", choices=("extend", "duplicate"))
    sub.add_parser("status").add_argument("--json", action="store_true")
    sub.add_parser("move-active")
    sub.add_parser("sumi")
    args = parser.parse_args()

    LOCK_PATH.parent.mkdir(parents=True, exist_ok=True)
    with LOCK_PATH.open("w") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        try:
            if args.command == "status":
                value = status()
                print(json.dumps(value) if args.json else value["mode"])
                return 0 if value.get("available") else 1
            if args.command == "toggle":
                if status().get("active"):
                    turn_off()
                    message = ("Companion display off", "Display layout kept in place")
                else:
                    active_mode = turn_on()
                    message = ("Companion display on", active_mode.capitalize())
            elif args.command == "on":
                active_mode = turn_on(args.mode)
                message = ("Companion display on", active_mode.capitalize())
            elif args.command == "off":
                turn_off()
                message = ("Companion display off", "Display layout kept in place")
            elif args.command == "remove":
                remove_output()
                message = ("Companion display removed", "Workspaces returned to the primary display")
            elif args.command == "mode":
                set_mode(args.mode)
                message = ("Companion display mode", args.mode.capitalize())
            elif args.command == "move-active":
                if not status().get("active"):
                    raise IpadModeError("Companion display is not active")
                if mode_from_system() != "extend":
                    raise IpadModeError("Windows can only move to the companion display in Extend mode")
                hypr_eval(
                    "hl.dispatch(hl.dsp.window.move({ "
                    f"monitor = {json.dumps(OUTPUT)}"
                    " }))"
                )
                message = ("Window moved", "Companion display")
            else:
                if not status().get("active") or mode_from_system() != "extend":
                    raise IpadModeError("Enable the companion display in Extend mode first")
                place_sumi()
                message = ("Sumi ready", "Moved to IPAD")
            if not args.quiet:
                notify(*message)
            return 0
        except (IpadModeError, OSError) as exc:
            if not args.quiet:
                notify("Companion display failed", str(exc), "critical")
            print(f"ipad-mode: {exc}", file=sys.stderr)
            return 1


if __name__ == "__main__":
    raise SystemExit(main())
